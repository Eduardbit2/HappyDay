APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
APP_ALLOWED_HOSTS=["127.0.0.1","localhost"]
APP_DATA_DIR=./data
APP_LOG_LEVEL=INFO
TZ=Europe/Moscow
PYTHONUTF8=1
APP_SESSION_HOURS=168
APP_SCHEDULER_ENABLED=true
# Токен из BotFather; пустое значение отключает Telegram. Не публикуйте рабочий токен.
APP_TELEGRAM_TOKEN=
