# Шаблон переменных Dockhand. Не сохраняйте рабочий токен в Git.
HAPPYDAY_IMAGE_TAG=replace-with-commit
HAPPYDAY_DATA_PATH=/volume1/docker/happyday/data
APP_BASE_URL=https://happyday.example.com
APP_ALLOWED_HOSTS=["happyday.example.com"]
# Укажите адрес, с которого DSM proxy приходит в Docker-сеть; wildcard не нужен.
HAPPYDAY_TRUSTED_PROXIES=127.0.0.1
APP_TELEGRAM_TOKEN=
